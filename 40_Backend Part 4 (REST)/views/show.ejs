<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post ID</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h1>Here is your post details</h1>
    <p>Post id: <%= post.id %>
    </p>
    <div class="post">
        <h3 class="username"> Username: <%= post.username %>
        </h3><br>
        <h3 class="content"> Content: <%= post.content %>
        </h3>
    </div>
</body>

</html>